# Copy to .env and fill in. Never commit .env.
DATABASE_URL="file:./dev.db"

# "synthetic" (default) until the first bank agreement and counsel sign-off (Platform Flow v4, section 52).
# Staff and applicants see a test-mode notice. Set to "live" only when real customer data is allowed.
DATA_MODE="synthetic"

# Public site address used for canonical URLs, the sitemap and links in messages (decision pending on the final domain).
NEXT_PUBLIC_SITE_URL="https://loansforindia.com"
# Base URL for links staff re-issue by hand. Defaults to NEXT_PUBLIC_SITE_URL / the current host.
PUBLIC_BASE_URL=""

# Set to 1 only when the app runs behind a reverse proxy / load balancer you control:
# then X-Forwarded-For / X-Forwarded-Proto are trusted (client IP for throttling and consent evidence, HTTPS detection).
TRUST_PROXY="0"

# ---------- Staff logins ----------
# Staff sign in at /admin/login with a password and an authenticator app (TOTP). Accounts live in the database.
# Bootstrap the first master admin with the CLI (prints a temporary password once):
#   npm run staff -- create jp SUPER_ADMIN "JP"
# Or import a one-time list from STAFF_USERS, then delete the passwords from this file:
#   npm run staff -- import-env
# STAFF_USERS='[{"username":"jp","name":"JP","role":"SUPER_ADMIN","password":"a-long-unique-password"}]'
# Roles: SUPER_ADMIN, OPS_MANAGER, OPS_EXECUTIVE, DOCUMENT_REVIEWER, DSA_OPERATOR, BANK_MANAGER, FINANCE, COMPLIANCE, FRAUD_RISK, SUPPORT, CONTENT_EDITOR.
STAFF_USERS=""

# ---------- Encryption ----------
# Generate each key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts PAN, bank account numbers and staff MFA secrets (falls back to DOCUMENT_ENCRYPTION_KEY). Required in production.
FIELD_ENCRYPTION_KEY=""
# Encrypts uploaded documents at rest. Required in production.
DOCUMENT_ENCRYPTION_KEY=""
# Folder for encrypted uploads (default ./storage). Production: a private, encrypted, India-region bucket behind the same interface.
STORAGE_DIR="./storage"
# Path to ClamAV's clamscan/clamdscan. Required in production; uploads are refused without it.
CLAMSCAN_PATH=""

# ---------- Messaging ----------
# No SMS provider is connected until DLT registration (sender header + templates) is done.
# Development and tests print messages (including OTPs) to the server console. Production without a provider refuses to send OTPs.
SMS_PROVIDER=""
# DLT template id of the OTP message, once registered.
DLT_TEMPLATE_OTP=""
