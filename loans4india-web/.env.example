# Copy to .env and fill in.
DATABASE_URL="file:./dev.db"

# Staff logins for /admin (HTTP Basic, temporary until staff accounts with MFA).
# One JSON list; passwords at least 12 characters (production refuses to start otherwise).
# Roles: OPS_MANAGER, OPS_EXECUTIVE, DOCUMENT_REVIEWER, DSA_OPERATOR, BANK_MANAGER, COMPLIANCE, FRAUD_RISK, SUPER_ADMIN, FINANCE, SUPPORT.
# "banks" lists the bank portals a DSA_OPERATOR holds a login for (ids from src/config/banks.ts).
# SUPER_ADMIN is the master admin: every action of every role, plus the Staff and Activity screens.
# Put at least the master admin here; everyone else can be added from /admin/staff.
# Example (one line):
# STAFF_USERS='[{"username":"jp","name":"JP","role":"SUPER_ADMIN","password":"a-long-password-1"},{"username":"asha","name":"Asha","role":"OPS_EXECUTIVE","password":"a-long-password-2"},{"username":"op1","name":"Ravi","role":"DSA_OPERATOR","password":"a-long-password-3","banks":["demo-bank-a","demo-nbfc-b"]}]'
STAFF_USERS=""
# Used only when STAFF_USERS is empty: one login with the Ops Manager role.
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me-now"

# Encrypts PAN and bank account numbers in the database (same format as DOCUMENT_ENCRYPTION_KEY).
# Required in production. Falls back to DOCUMENT_ENCRYPTION_KEY, then a dev-only key.
FIELD_ENCRYPTION_KEY=""

# Document storage. Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production. Without it, development uses a fixed dev-only key.
DOCUMENT_ENCRYPTION_KEY=""
# Folder for encrypted uploads (default ./storage)
STORAGE_DIR="./storage"
# Path to ClamAV's clamscan/clamdscan. Required in production; uploads are refused without it.
CLAMSCAN_PATH=""
# Base URL used in applicant links staff re-issue (e.g. https://loansforindia.com). Defaults to the current host.
PUBLIC_BASE_URL=""
